# Where the browser sends API calls.
# "/api" = same origin (Vite proxies it in dev; use a Vercel/Netlify rewrite in production).
# Or a full URL such as https://your-api.onrender.com/api
VITE_API_URL=/api

# Public URL of the deployed site (used for canonical URLs, Open Graph, JSON-LD)
VITE_SITE_URL=http://localhost:5173

# Dev only: where the Vite proxy forwards /api
DEV_API_TARGET=http://localhost:5000